# Application
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=naroom
DB_USERNAME=naroom
DB_PASSWORD=
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# AI Worker (비동기 AI 작업 폴링, PostgreSQL ai_jobs + SKIP LOCKED; Redis 미사용)
AI_WORKER_ENABLED=false
AI_WORKER_BATCH_SIZE=20
AI_WORKER_LEASE_TIMEOUT=5m
AI_WORKER_POLL_INTERVAL=30s

# Client
FRONTEND_ORIGIN=http://localhost:8081

# Google Cloud / Firebase
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Logging
LOG_LEVEL=DEBUG