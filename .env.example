# Application
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=naroom
DB_USERNAME=naroom
DB_PASSWORD=
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# Google 로그인 - 플랫폼별 OAuth Client ID(모두 ID Token aud 허용 목록에 들어간다)
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Apple 로그인 - iOS 앱 Bundle ID (Sign in with Apple identity token의 aud와 일치해야 함)
APPLE_OAUTH_CLIENT_ID=

# 관리자 웹(naroom-admin) Google OIDC 로그인 - 회원용 Google Client와 별도 client다.
# ADMIN_GOOGLE_OAUTH_CLIENT_SECRET은 회원 쪽 OAuth Client ID들과 달리 실제 비밀값이다(서버가 Authorization
# Code를 교환할 때 씀) - 절대 커밋·로그·클라이언트 노출 금지.
ADMIN_GOOGLE_OAUTH_CLIENT_ID=
ADMIN_GOOGLE_OAUTH_CLIENT_SECRET=
# 관리자 세션 쿠키 - 로컬은 보통 비워둔다(도메인 없이 현재 호스트에만 적용).
# production/staging은 naroom-admin과 naroom-api가 공유하는 상위 도메인(예: .naroom.xxx)으로 설정한다.
ADMIN_SESSION_COOKIE_DOMAIN=
# 관리자 로그인 성공 후 리다이렉트할 naroom-admin 프론트 URL. 프론트 저장소가 아직 없어 로컬은 비워둔다.
ADMIN_FRONTEND_REDIRECT_URI=
# 이 이메일로 처음 로그인하면 서버가 자동으로 만들어둔 초대를 통해 즉시 SUPER_ADMIN이 된다(재배포해도
# 이 값만 설정돼 있으면 다시 수동 bootstrap을 할 필요가 없다). 로컬 개발에서는 비워둬도 된다.
ADMIN_SUPER_ADMIN_BOOTSTRAP_EMAIL=

# Push notifications (임시 AES-256/GCM 대칭키, base64. Supabase Vault 암호화 모듈 도입 전까지만 사용 - docs/instruction/notification 설계 문서 DEC-03 참고)
PUSH_TOKEN_ENCRYPTION_KEY=
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_DISPATCH_POLL_INTERVAL=5m

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# AI Worker (비동기 AI 작업 폴링, PostgreSQL ai_jobs + SKIP LOCKED; Redis 미사용)
AI_WORKER_ENABLED=false
AI_WORKER_BATCH_SIZE=20
AI_WORKER_LEASE_TIMEOUT=5m
AI_WORKER_POLL_INTERVAL=30s
AI_WORKER_EXECUTOR_CORE_SIZE=4
AI_WORKER_EXECUTOR_MAX_SIZE=8
AI_WORKER_EXECUTOR_QUEUE_CAPACITY=100

# Client
FRONTEND_ORIGIN=http://localhost:8081

# Google Cloud / Firebase
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Logging
LOG_LEVEL=DEBUG